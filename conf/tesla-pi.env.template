# Copy to /etc/default/tesla-pi (read by tesla-pi.service, cert-renew-watch.service
# and cert-renew-now.service via EnvironmentFile=).
#
# Contains CERT_SYNC_TOKEN — install as mode 0600, root-owned.

# The hostname the Tesla loads: the project's shared name, identical on every
# device. dnsmasq resolves it to the Pi itself while the AP is up, so it never
# leaves the car. nginx-carplay.conf substitutes this value at install time.
CARPLAY_DOMAIN=device.tesla-pi.humblebees.co
CERT_PATH=/etc/letsencrypt/live/device.tesla-pi.humblebees.co/fullchain.pem

# --- Certificate sync (scripts/cert-sync.sh) --------------------------------
# The device holds no Cloudflare credential: certs are issued centrally and
# pulled from this endpoint. See docs/turnkey-shared-domain-plan.md.
#
# Served from *.workers.dev, NOT a subdomain of CARPLAY_DOMAIN. Two reasons:
#   1. While the AP is up, dnsmasq answers every name with the Pi's own address
#      (wildcard A record) — so the sync endpoint must not live under a name the
#      Pi itself shadows.
#   2. workers.dev has valid TLS automatically. A two-deep custom hostname
#      (certs.tesla-pi.humblebees.co) is NOT covered by Cloudflare's free
#      Universal SSL, and the HTTPS handshake below would fail.
CERT_SYNC_URL=https://tesla-pi-cert-service.elwin-chia-1.workers.dev
CERT_SYNC_TOKEN=REPLACE_WITH_DEVICE_TOKEN

# Override defaults if needed:
# CERT_SYNC_TIMEOUT=30       # per-request curl timeout (seconds)
# CERT_SYNC_BACKOFF_S=21600  # min seconds between AP-down sync attempts (6 h)

# Where the server persists runtime settings (currently just CarPlay fps).
# Defaults to settings.local.json next to index.js if unset.
# TESLAPI_SETTINGS_FILE=/var/lib/tesla-pi/settings.json

# --- CarPlay tuning ---------------------------------------------------------
# Everything here has a working default in index.js; these are the knobs worth
# reaching for in the car, without a redeploy. Uncomment to change.
#
# Audio/video sync offset sent to the dongle, in ms. node-carplay's default is
# 300, sized for a head unit whose video path lags. Ours is a browser, so the
# assumption may not hold — walk it down and listen.
# CARPLAY_MEDIA_DELAY=300
#
# USB read pipeline (carplay-reader.js). We keep several reads outstanding at
# once instead of one at a time; this is the main lever on how far audio and
# video lag behind the phone. More in flight costs a little memory and nothing
# else. Set CARPLAY_USB_PIPELINE=off to fall back to node-carplay's own loop.
# CARPLAY_USB_PIPELINE=on
# CARPLAY_USB_INFLIGHT=16
# CARPLAY_USB_CHUNK=16384
#
# After a tap, ask the dongle for a fresh frame this many ms later, so a frame
# stuck in the decoder does not leave the screen looking frozen. 0 disables.
# CARPLAY_FORCE_REDRAW_MS=140
#
# Force the dongle's audio-transfer flag instead of deriving it from the Sound
# setting. 'off' sends the phone's audio to us over USB (Settings → Sound →
# This screen); 'on' keeps it in the dongle for Bluetooth. Testing only.
# CARPLAY_AUDIO_TRANSFER=
#
# --- When CarPlay connects --------------------------------------------------
# The dongle is what pulls the phone in: once opened over USB it advertises, and
# a paired iPhone joins the dongle's own 5 GHz AP — off home Wi-Fi, radios busy,
# battery draining — for as long as the Pi has power. On demand means the dongle
# stays closed until a browser page is open AND on screen in the car.
#
# This only sets the SHIPPED DEFAULT. Settings → CarPlay → "Connect only while
# this page is open" persists a user choice that wins over it.
# CARPLAY_ON_DEMAND=on
#
# Grace between the last visible page going away and the dongle closing. Long
# enough that swiping to the Tesla media app and back, or reloading, does not
# cost a full re-pair. Measured on a real device: excursions into the car's own
# menus run minutes, not seconds, and the re-pair afterwards costs 9-70 s — so
# this is deliberately generous. Lower it if you would rather your phone be
# released sooner when you walk away.
# CARPLAY_IDLE_STOP_MS=300000
#
# How long a page's "I am on screen" lasts without a refresh. The backstop for a
# browser that never fires visibilitychange: a hidden tab's timers are throttled
# to roughly one a minute, so its heartbeat lapses past this on its own.
# CARPLAY_DEMAND_TTL_MS=40000
#
# How long a page's vote outlives its control socket when that socket dies
# while the page was still on screen. The Tesla browser freezes a backgrounded
# tab and closes its sockets without notice, which is not the same thing as the
# driver walking away — this gives the reconnect room to land before the idle
# timer above starts running. Does not apply when the page said "hidden" first.
# CARPLAY_GHOST_LEASE_MS=15000

# --- In-car probe pages -----------------------------------------------------
# Where POSTed probe results are written, for static/mic-probe.html and
# static/webgpu-probe.html. Unset disables the upload endpoints entirely — the
# routes 404 rather than existing and refusing, so a normal box has nothing to
# reach. Files land as <probe>-<timestamp>-<name>, e.g.
# webgpu-probe-2026-08-27T14-07-22-000Z-report.json.
# PROBE_DIR=/var/tmp/tesla-pi-probe
#
# Former name, still honoured so deployed boxes keep working.
# MIC_PROBE_DIR=/var/tmp/mic-probe

# --- Settings → Dongle (firmware library) -----------------------------------
# Where downloaded dongle firmware images are cached. Changing this breaks the
# USB-stick writer: /usr/local/sbin/tesla-pi-dongle hardcodes the same path as
# the only directory its sudo grant will read from, and refuses anything it
# cannot see there. Change both or neither.
# FIRMWARE_DIR=/var/lib/tesla-pi/firmware
#
# The privileged mount/copy helper. Its absence disables only the stick writer —
# identifying the dongle and downloading firmware need no privilege, so the
# section still appears and explains what is missing.
# DONGLE_HELPER=/usr/local/sbin/tesla-pi-dongle
