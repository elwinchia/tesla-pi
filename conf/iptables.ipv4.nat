*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
# Internet sharing for AP clients. Policy stays DROP so only these two rules
# let anything across: the Tesla's outbound traffic to any interface that is
# not our own AP, and the return path for connections it opened. Nothing can
# be initiated *towards* the AP subnet from outside.
#
# Written against interface names rather than the uplink of the day, so the
# same ruleset covers eth0, wlan1 and a USB tether with no regeneration.
#
# Note this grants the car the same reach as any other device on the uplink's
# network, the home LAN included — normal router behaviour, but worth knowing
# if the AP passphrase is ever shared.
-A FORWARD -i wlan0 ! -o wlan0 -j ACCEPT
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
COMMIT

*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -d 240.3.3.4/32 -i wlan0 -p tcp -m tcp --dport 80 -j DNAT --to-destination 192.168.4.254
-A PREROUTING -d 240.3.3.4/32 -i wlan0 -p tcp -m tcp --dport 443 -j DNAT --to-destination 192.168.4.254
# Karaoke addon (docs/karaoke-addon.md). The Nightingale SPA is served from an
# origin root and cannot be mounted under a path on the CarPlay site, so it gets
# its own port on the same hostname — which means it needs its own DNAT, or the
# car dials 240.3.3.4:8443 and nothing answers. Harmless when the addon is not
# installed: the packet is redirected to a port nginx is not listening on.
-A PREROUTING -d 240.3.3.4/32 -i wlan0 -p tcp -m tcp --dport 8443 -j DNAT --to-destination 192.168.4.254
# Source-NAT the AP subnet onto whichever uplink carries the packet. Scoped to
# 192.168.4.0/24 so nothing else the Pi routes is silently rewritten.
-A POSTROUTING -s 192.168.4.0/24 ! -o wlan0 -j MASQUERADE
COMMIT
