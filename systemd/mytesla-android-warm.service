[Unit]
Description=Pre-warm the Waydroid Android runtime in the background
Documentation=https://github.com/elwinchia/mytesla/blob/main/docs/android-addon.md
# Bring Android up only AFTER CarPlay is running. Android is a passenger, never
# a blocker: it must not delay boot or compete with mytesla.service for the
# first slice of CPU/RAM the car actually needs. We only order after it — we do
# not Require it, so a CarPlay failure never drags Android's warm-up with it.
After=mytesla.service waydroid-container.service network-online.target
Wants=mytesla.service

[Service]
# oneshot + RemainAfterExit: `start` blocks until the Android session reports
# RUNNING, then the unit stays "active" to represent the warm runtime. systemd
# stops it (freeing the ~1.5-2 GB the container holds) on shutdown via ExecStop.
Type=oneshot
RemainAfterExit=yes
# Let CarPlay settle through its own startup before we spend a core booting
# Android. Cheap insurance for the one thing that matters first.
ExecStartPre=/bin/sleep 20
# Bring up container + headless compositor + Android session. Does NOT
# foreground any app — the bridge foregrounds Waze on the first viewer tap, so
# the idle runtime just sits on the Android home screen rendering almost
# nothing. Runs as root (no sudo): this unit is root-owned.
ExecStart=/usr/local/sbin/mytesla-android start
ExecStop=/usr/local/sbin/mytesla-android stop
# Matches the helper's own start deadline (cold Waydroid boot can take ~2 min).
TimeoutStartSec=200
# Never let a warm-up failure spam restarts; the bridge self-heals on tap.
Restart=no

[Install]
WantedBy=multi-user.target
