[Unit]
Description=On-demand TLS cert renewal (AP→home-Wi-Fi→certbot→restore-AP)
After=hostapd.service dnsmasq.service network.target
Wants=hostapd.service dnsmasq.service

[Service]
Type=oneshot
EnvironmentFile=/etc/default/tesla-pi
ExecStart=/opt/tesla-pi/scripts/cert-renew-now.sh

# Needs root for hostapd, ip, wpa_supplicant, certbot, nginx -s reload.
# No [Install] block — never enabled, only started on demand via
# `sudo systemctl start --no-block cert-renew-now.service` from the Node app.
