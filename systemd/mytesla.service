[Unit]
Description=Tesla CarPlay
After=network.target

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=30s
# Set these to the account that owns the checkout and its path before
# installing, e.g.:  sudo sed -i "s|__MYTESLA_USER__|$USER|; s|__MYTESLA_DIR__|$PWD|" mytesla.service
User=__MYTESLA_USER__
WorkingDirectory=__MYTESLA_DIR__
EnvironmentFile=-/etc/default/mytesla
ExecStart=/usr/bin/node __MYTESLA_DIR__/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
