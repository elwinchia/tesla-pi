// A GT3-style flat-6 for engine-sim, written for this project: engine-sim
// bundles no flat-6. Built on the pattern of its Subaru EJ25 boxer script
// (assets/engines/atg-video-2/01_subaru_ej25_eh.mr): 4.0 L, 102 x 81.5 mm,
// two banks of three at +/-90 degrees, opposed pistons on throws 180 degrees
// apart, firing 1-6-2-4-3-5 every 120 degrees, race-engine cams and a light
// flywheel, revving to 9,000 rpm. The numbers are our own estimates, chosen
// to suggest the type of engine, not measured from any particular car.
//
// Crank geometry, from how the EJ25 lays out its boxer: a cylinder on the
// +90 bank is at TDC when the crank angle equals its rod journal angle, one
// on the -90 bank 180 degrees later. So for firing at
//   1: 0   6: 120   2: 240   4: 360   3: 480   5: 600  (degrees of the cycle)
// the journals are 1: 0, 2: 240, 3: 120 (bank A) and 4: 180, 5: 60, 6: 300
// (bank B).

import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node turbulence_to_flame_speed_ratio {
    alias output __out:
        function(5.0)
            .add_sample(0.0, 1.0 * 3.0)
            .add_sample(5.0, 1.0 * 1.5 * 5.0)
            .add_sample(10.0, 1.0 * 1.5 * 10.0)
            .add_sample(15.0, 1.1 * 1.5 * 15.0)
            .add_sample(20.0, 1.25 * 1.5 * 20.0)
            .add_sample(25.0, 1.25 * 1.5 * 25.0)
            .add_sample(30.0, 1.25 * 1.5 * 30.0)
            .add_sample(35.0, 1.25 * 1.5 * 35.0)
            .add_sample(40.0, 1.25 * 1.5 * 40.0)
            .add_sample(45.0, 1.25 * 1.5 * 45.0);
}

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
}

private node f6_head {
    input intake_camshaft;
    input exhaust_camshaft;
    input chamber_volume: 70 * units.cc;
    input intake_runner_volume: 160.0 * units.cc;
    input intake_runner_cross_section_area: 1.9 * units.inch * 1.9 * units.inch;
    input exhaust_runner_volume: 55.0 * units.cc;
    input exhaust_runner_cross_section_area: 1.4 * units.inch * 1.4 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    // Bigger valves than the EJ25's: its flow table, scaled up.
    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 72 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 129 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 195 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 268 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 311 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 335 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 350 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 355 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 358 * flow_attenuation)
        .add_flow_sample(500 * lift_scale, 360 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 46 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 90 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 141 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 200 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 245 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 278 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 294 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 306 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 308 * flow_attenuation)
        .add_flow_sample(500 * lift_scale, 310 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

// One camshaft pair per bank, a lobe per cylinder at its firing point.
// Bank A fires at 0, 2 and 4 sixths of the cycle (cylinders 1, 2, 3);
// bank B at 3, 5 and 1 sixths (cylinders 4, 5, 6).
private node f6_camshaft {
    input lobe_profile;
    input intake_lobe_profile: lobe_profile;
    input exhaust_lobe_profile: lobe_profile;
    input lobe_separation: 112 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0 * units.deg;
    input base_radius: 1.0 * units.inch;

    output intake_cam_0: _intake_cam_0;
    output exhaust_cam_0: _exhaust_cam_0;
    output intake_cam_1: _intake_cam_1;
    output exhaust_cam_1: _exhaust_cam_1;

    camshaft_parameters params (
        advance: advance,
        base_radius: base_radius
    )

    camshaft _intake_cam_0(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_0(params, lobe_profile: exhaust_lobe_profile)
    camshaft _intake_cam_1(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_1(params, lobe_profile: exhaust_lobe_profile)

    label rot360(360 * units.deg)

    _exhaust_cam_0
        .add_lobe(rot360 - exhaust_lobe_center + (0.0 / 6) * cycle)
        .add_lobe(rot360 - exhaust_lobe_center + (2.0 / 6) * cycle)
        .add_lobe(rot360 - exhaust_lobe_center + (4.0 / 6) * cycle)
    _intake_cam_0
        .add_lobe(rot360 + intake_lobe_center + (0.0 / 6) * cycle)
        .add_lobe(rot360 + intake_lobe_center + (2.0 / 6) * cycle)
        .add_lobe(rot360 + intake_lobe_center + (4.0 / 6) * cycle)

    _exhaust_cam_1
        .add_lobe(rot360 - exhaust_lobe_center + (3.0 / 6) * cycle)
        .add_lobe(rot360 - exhaust_lobe_center + (5.0 / 6) * cycle)
        .add_lobe(rot360 - exhaust_lobe_center + (1.0 / 6) * cycle)
    _intake_cam_1
        .add_lobe(rot360 + intake_lobe_center + (3.0 / 6) * cycle)
        .add_lobe(rot360 + intake_lobe_center + (5.0 / 6) * cycle)
        .add_lobe(rot360 + intake_lobe_center + (1.0 / 6) * cycle)
}

public node gt3_flat6 {
    alias output __out: engine;

    engine engine(
        name: "GT3-style flat-6",
        starter_torque: 90 * units.lb_ft,
        starter_speed: 500 * units.rpm,
        redline: 9000 * units.rpm,
        fuel: fuel(
            max_burning_efficiency: 0.9,
            turbulence_to_flame_speed_ratio: turbulence_to_flame_speed_ratio()
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.01,
        noise: 1.0,
        jitter: 0.4,
        simulation_frequency: 12000
    )

    wires wires()

    label stroke(81.5 * units.mm)
    label bore(102 * units.mm)
    label rod_length(5.0 * units.inch)
    label rod_mass(450 * units.g)
    label compression_height(1.0 * units.inch)
    label crank_mass(11.0 * units.kg)
    label flywheel_mass(4.0 * units.kg)
    label flywheel_radius(5.5 * units.inch)

    label crank_moment(
        disk_moment_of_inertia(mass: crank_mass, radius: stroke / 2)
    )
    label flywheel_moment(
        disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius) * 2
    )
    label other_moment(
        disk_moment_of_inertia(mass: 8 * units.kg, radius: 6.0 * units.cm)
    )

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 1.2 * units.lb_ft,
        moment_of_inertia:
            crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 180 * units.deg
    )

    rod_journal rj1(angle: 0.0 * units.deg)
    rod_journal rj2(angle: 240.0 * units.deg)
    rod_journal rj3(angle: 120.0 * units.deg)
    rod_journal rj4(angle: 180.0 * units.deg)
    rod_journal rj5(angle: 60.0 * units.deg)
    rod_journal rj6(angle: 300.0 * units.deg)
    c0
        .add_rod_journal(rj1)
        .add_rod_journal(rj4)
        .add_rod_journal(rj2)
        .add_rod_journal(rj5)
        .add_rod_journal(rj3)
        .add_rod_journal(rj6)

    piston_parameters piston_params(
        mass: (380 + 120) * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake(
        plenum_volume: 2.0 * units.L,
        plenum_cross_section_area: 30.0 * units.cm2,
        intake_flow_rate: k_carb(700.0),
        runner_flow_rate: k_carb(160.0),
        runner_length: 10.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.9975,
        velocity_decay: 1.0
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(1400.0),
        primary_tube_length: 30.0 * units.inch,
        primary_flow_rate: k_carb(500.0),
        velocity_decay: 1.0
    )

    // One collector per bank, as on a flat-6.
    exhaust_system exhaust0(
        es_params,
        length: 600 * units.mm,
        audio_volume: 0.5 * 0.02,
        impulse_response: ir_lib.minimal_muffling_02
    )
    exhaust_system exhaust1(
        es_params,
        length: 620 * units.mm,
        audio_volume: 0.5 * 0.02,
        impulse_response: ir_lib.minimal_muffling_02
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    // Equal-length headers: a smooth, even howl rather than a boxer-four rumble.
    cylinder_bank b0(bank_params, angle: 90.0 * units.deg)
    cylinder_bank b1(bank_params, angle: -90.0 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            primary_length: 3.0 * units.inch,
            sound_attenuation: 1.0
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.0015)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            primary_length: 3.1 * units.inch,
            sound_attenuation: 0.95
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            primary_length: 3.0 * units.inch,
            sound_attenuation: 1.05
        )
        .set_cylinder_head(
            f6_head(
                flip_display: true,
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0)
        )
    b1
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire4,
            primary_length: 3.0 * units.inch,
            sound_attenuation: 1.0
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.0015)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire5,
            primary_length: 3.1 * units.inch,
            sound_attenuation: 0.95
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj6,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire6,
            primary_length: 3.0 * units.inch,
            sound_attenuation: 1.05
        )
        .set_cylinder_head(
            f6_head(
                flip_display: false,
                intake_camshaft: camshaft.intake_cam_1,
                exhaust_camshaft: camshaft.exhaust_cam_1)
        )

    engine
        .add_cylinder_bank(b0)
        .add_cylinder_bank(b1)

    engine.add_crankshaft(c0)

    // Race-engine cams: long duration, high lift.
    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 262 * units.deg,
        gamma: 2.0,
        lift: 12.0 * units.mm,
        steps: 100
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 256 * units.deg,
        gamma: 2.0,
        lift: 11.0 * units.mm,
        steps: 100
    )

    f6_camshaft camshaft(
        lobe_profile: "N/A",

        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 112 * units.deg,
        exhaust_lobe_center: 110 * units.deg,
        base_radius: (34.0 / 2) * units.mm
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 20 * units.deg)
        .add_sample(1000 * units.rpm, 22 * units.deg)
        .add_sample(2000 * units.rpm, 28 * units.deg)
        .add_sample(3000 * units.rpm, 34 * units.deg)
        .add_sample(4000 * units.rpm, 38 * units.deg)
        .add_sample(5000 * units.rpm, 40 * units.deg)
        .add_sample(6000 * units.rpm, 40 * units.deg)
        .add_sample(7000 * units.rpm, 40 * units.deg)
        .add_sample(8000 * units.rpm, 40 * units.deg)
        .add_sample(9000 * units.rpm, 40 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 9000 * units.rpm,
        limiter_duration: 0.06)
    ignition_module
            .connect_wire(wires.wire1, (0.0 / 6.0) * cycle)
            .connect_wire(wires.wire6, (1.0 / 6.0) * cycle)
            .connect_wire(wires.wire2, (2.0 / 6.0) * cycle)
            .connect_wire(wires.wire4, (3.0 / 6.0) * cycle)
            .connect_wire(wires.wire3, (4.0 / 6.0) * cycle)
            .connect_wire(wires.wire5, (5.0 / 6.0) * cycle)

    engine.add_ignition_module(ignition_module)
}

label car_mass(3160 * units.lb)

private node gt3_vehicle {
    alias output __out:
        vehicle(
            mass: car_mass,
            drag_coefficient: 0.34,
            cross_sectional_area: (72 * units.inch) * (50 * units.inch),
            diff_ratio: 4.97,
            tire_radius: 12.5 * units.inch,
            rolling_resistance: 0.015 * car_mass * 9.81
        );
}

private node gt3_transmission {
    alias output __out:
        transmission(
            max_clutch_torque: 400 * units.lb_ft
        )
        .add_gear(3.75)
        .add_gear(2.38)
        .add_gear(1.72)
        .add_gear(1.34)
        .add_gear(1.11)
        .add_gear(0.96)
        .add_gear(0.84);
}

public node main {
    set_engine(gt3_flat6())
    set_vehicle(gt3_vehicle())
    set_transmission(gt3_transmission())
}

main()
